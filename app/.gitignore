```gitignore
# Local configuration
local.properties
*.local

# Android Studio / IntelliJ
.idea/
*.iml

# Gradle
.gradle/
build/
**/build/

# Generated Android files
captures/
.externalNativeBuild/
.cxx/

# Signing credentials
*.jks
*.keystore
keystore.properties

# Operating system files
.DS_Store
Thumbs.db

# Logs
*.log
```